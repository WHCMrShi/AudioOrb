<Page
    x:Class="AudioOrb.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AudioOrb.Controls"
    xmlns:models="using:AudioOrb.Models"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="DeviceRowTemplate" x:DataType="models:DeviceRow">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="40" Height="40" VerticalAlignment="Center">
                        <FontIcon Glyph="{x:Bind IconGlyph}"
                                  FontSize="18"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Name}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="460" />
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind DefaultVisibility, Mode=OneWay}">
                                <TextBlock Text="当前"
                                           FontSize="10"
                                           Foreground="White" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind Detail}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ToggleSwitch Grid.Column="2"
                                  IsOn="{x:Bind IsSelected, Mode=OneWay}"
                                  Width="52"
                                  OnContent=""
                                  OffContent=""
                                  Tag="{x:Bind Id}"
                                  Toggled="DeviceToggle_Toggled"
                                  Margin="0,0,-112,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel Padding="36,22,48,48">
            <TextBlock Text="输出设备"
                       FontSize="28"
                       FontWeight="SemiBold" />
            <TextBlock Text="选择参与一键切换的设备，并调整循环顺序。"
                       Margin="0,4,0,20"
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <InfoBar x:Name="StatusInfoBar"
                     IsOpen="False"
                     IsClosable="True"
                     Margin="0,0,0,12" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="活动输出设备"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="DeviceCountText"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ProgressRing x:Name="RefreshRing"
                              Grid.Column="1"
                              Width="20"
                              Height="20"
                              IsActive="False"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center" />

                <Button x:Name="RefreshButton"
                        Grid.Column="2"
                        Content="刷新"
                        Click="RefreshButton_Click" />
            </Grid>

            <Border x:Name="EmptyState"
                    Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="20"
                    Margin="0,0,0,8">
                <StackPanel Spacing="8">
                    <TextBlock Text="未检测到活动的输出设备"
                               FontWeight="SemiBold" />
                    <TextBlock Text="请连接耳机或扬声器，然后在 Windows 声音设置中启用设备。"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <Button Content="打开 Windows 声音设置"
                            Click="OpenSoundSettings_Click" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="DeviceItems"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          ItemTemplate="{StaticResource DeviceRowTemplate}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>

            <TextBlock Text="至少选择两个设备才能一键循环切换。设置会自动保存。"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
