<Page
    x:Class="AudioOrb.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AudioOrb.Controls"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="36,22,48,48">
            <TextBlock Text="关于"
                       FontSize="28"
                       FontWeight="SemiBold" />
            <TextBlock Text="声枢 · AudioOrb"
                       Margin="0,4,0,20"
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image Source="ms-appx:///Assets/AppIcon.png"
                           Width="72"
                           Height="72"
                           VerticalAlignment="Top" />

                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="声枢"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Windows 11 输出设备快速切换球"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="VersionText"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="为同时使用耳机和音响的玩家设计。单击桌面组件，在预设的输出设备之间立即切换，不必再打开系统声音设置。"
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   MaxWidth="640" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="运行信息"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <controls:SettingsCard Title="技术栈"
                                   Description="C# · .NET 8 · WinUI 3 / Windows App SDK · Core Audio"
                                   Glyph="&#xE943;" />

            <controls:SettingsCard Title="当前配置"
                                   Glyph="&#xE9F9;">
                <controls:SettingsCard.CardContent>
                    <TextBlock x:Name="ConfigText"
                               Width="420"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </controls:SettingsCard.CardContent>
            </controls:SettingsCard>

            <controls:SettingsCard Title="设置文件"
                                   Glyph="&#xE8A5;">
                <controls:SettingsCard.CardContent>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="SettingsPathText"
                                   Width="360"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Content="打开"
                                Click="OpenSettingsFolder_Click" />
                    </StackPanel>
                </controls:SettingsCard.CardContent>
            </controls:SettingsCard>

            <controls:SettingsCard Title="运行日志"
                                   Description="仅记录启动、设备切换和异常信息，不上传任何数据。"
                                   Glyph="&#xE9D9;">
                <controls:SettingsCard.CardContent>
                    <Button Content="打开日志目录"
                            Click="OpenLogFolder_Click" />
                </controls:SettingsCard.CardContent>
            </controls:SettingsCard>

            <TextBlock Text="操作方式"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,20,0,8" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="0,0,0,8">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="单击" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="切换到下一台已选设备" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="滚轮" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="向前或向后循环切换" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="右键" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="选择设备、打开设置、开关机启动或退出" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="拖动" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="移动桌面组件，松手后自动吸附屏幕边缘" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="声枢不会收集或上传任何个人数据。所有配置只保存在本机。"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,16" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="打开 Windows 声音设置"
                        Click="OpenSoundSettings_Click" />
                <Button Content="退出声枢"
                        Click="Exit_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
