<Page
    x:Class="AudioOrb.Pages.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AudioOrb.Controls"
    xmlns:conv="using:AudioOrb.Converters"
    Background="Transparent">

    <Page.Resources>
        <conv:WidthPresetNameConverter x:Key="WidthPresetNameConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="36,22,48,48">
            <TextBlock Text="外观"
                       FontSize="28"
                       FontWeight="SemiBold" />
            <TextBlock Text="桌面组件采用 Fluent 2 Solid 实色材质：不透明表面、中性层级和轻阴影，不依赖系统模糊。"
                       Margin="0,4,0,20"
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <InfoBar x:Name="StatusInfoBar"
                     IsOpen="False"
                     IsClosable="True"
                     Margin="0,0,0,12" />

            <TextBlock Text="主题"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,4,0,8" />

            <controls:SettingsCard Title="应用主题"
                                   Description="设置窗口、菜单和桌面组件的浅色/深色外观。"
                                   Glyph="&#xE790;">
                <controls:SettingsCard.CardContent>
                    <ComboBox x:Name="ThemePicker"
                              Width="150"
                              SelectionChanged="ThemePicker_SelectionChanged">
                        <ComboBoxItem Content="跟随系统" Tag="System" />
                        <ComboBoxItem Content="浅色" Tag="Light" />
                        <ComboBoxItem Content="深色" Tag="Dark" />
                    </ComboBox>
                </controls:SettingsCard.CardContent>
            </controls:SettingsCard>

            <TextBlock Text="桌面组件"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,20,0,8" />

            <controls:SettingsCard x:Name="WidthCard"
                                   Title="大小与布局"
                                   Description="一个滑杆同时控制卡片尺寸和布局：图标方形、名称、标准、宽。"
                                   Glyph="&#xE740;">
                <controls:SettingsCard.CardContent>
                    <Slider x:Name="WidthSlider"
                            Width="320"
                            Minimum="0"
                            Maximum="3"
                            StepFrequency="1"
                            TickPlacement="None"
                            IsThumbToolTipEnabled="True"
                            ThumbToolTipValueConverter="{StaticResource WidthPresetNameConverter}"
                            ValueChanged="WidthSlider_ValueChanged" />
                </controls:SettingsCard.CardContent>
            </controls:SettingsCard>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,20,0,0">
                <Button Content="恢复默认外观"
                        Click="RestoreDefaults_Click" />
            </StackPanel>

            <TextBlock Text="外观设置会立即生效，并自动保存到本地。"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Margin="0,18,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
