<Window
    x:Class="AudioOrb.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          PointerPressed="RootGrid_PointerPressed"
          PointerMoved="RootGrid_PointerMoved"
          PointerReleased="RootGrid_PointerReleased"
          PointerCanceled="RootGrid_PointerCanceled"
          PointerCaptureLost="RootGrid_PointerCaptureLost"
          PointerWheelChanged="RootGrid_PointerWheelChanged"
          RightTapped="RootGrid_RightTapped"
          Loaded="RootGrid_Loaded">
        <Grid.Resources>
            <Style x:Key="ActionIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Border x:Name="WidgetSurface"
                Background="Transparent"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid x:Name="ContentRoot"
                      Padding="16,0"
                      ColumnSpacing="12"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ContentScale"
                                            ScaleX="1"
                                            ScaleY="1" />
                            <TranslateTransform x:Name="ContentTranslate" Y="0" />
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="20"
                          Height="20"
                          VerticalAlignment="Center">
                        <FontIcon x:Name="DeviceIcon"
                                  Glyph="&#xE767;"
                                  FontSize="20"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <ProgressRing x:Name="BusyRing"
                                      Width="18"
                                      Height="18"
                                      IsActive="False"
                                      Visibility="Collapsed"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Spacing="1"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="DeviceNameText"
                                   Text="正在读取输出设备"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DeviceDetailText"
                                   Text="单击切换 · 右键更多"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel x:Name="VolumePanel"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="VolumeText"
                                   Text="--"
                                   Width="42"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                        <Grid Width="3" Height="34">
                            <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    CornerRadius="1.5" />
                            <Border x:Name="VolumeBarFill"
                                    Width="3"
                                    Height="24"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource TextFillColorSecondaryBrush}"
                                    CornerRadius="1.5" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid x:Name="CompactRoot"
                      Visibility="Collapsed"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="CompactScale"
                                        ScaleX="1"
                                        ScaleY="1" />
                    </Grid.RenderTransform>
                    <FontIcon x:Name="CompactIcon"
                              Glyph="&#xE767;"
                              FontSize="24"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    <ProgressRing x:Name="CompactBusyRing"
                                  Width="22"
                                  Height="22"
                                  IsActive="False"
                                  Visibility="Collapsed"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <Grid x:Name="VolumeView"
                      Visibility="Collapsed"
                      IsHitTestVisible="False"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="VolumeViewScale"
                                        ScaleX="1"
                                        ScaleY="1" />
                    </Grid.RenderTransform>

                    <StackPanel x:Name="VolumeFullPanel"
                                Orientation="Horizontal"
                                Spacing="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <FontIcon x:Name="VolumeViewIcon"
                                  Glyph="&#xE767;"
                                  FontSize="20"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="VolumeViewText"
                                   Text="70%"
                                   Width="56"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Grid Width="64" Height="4" VerticalAlignment="Center">
                            <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    CornerRadius="2" />
                            <Border x:Name="VolumeViewBarFill"
                                    Width="44"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource TextFillColorPrimaryBrush}"
                                    CornerRadius="2" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="VolumeCompactPanel"
                                Orientation="Horizontal"
                                Visibility="Collapsed"
                                Spacing="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="VolumeCompactText"
                                   Text="70%"
                                   Width="56"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <Grid x:Name="VolumeCompactBar" Width="64" Height="4">
                            <Border Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    CornerRadius="2" />
                            <Border x:Name="VolumeCompactBarFill"
                                    Width="44"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource TextFillColorPrimaryBrush}"
                                    CornerRadius="2" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ActionView"
                      Visibility="Collapsed"
                      Background="Transparent"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ActionViewScale"
                                        ScaleX="1"
                                        ScaleY="1" />
                    </Grid.RenderTransform>
                    <Button x:Name="ActionSettingsButton"
                            Style="{StaticResource ActionIconButtonStyle}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="ActionSettings_Click"
                            ToolTipService.ToolTip="设置"
                            AutomationProperties.Name="设置">
                        <FontIcon Glyph="&#xE713;" FontSize="20" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
