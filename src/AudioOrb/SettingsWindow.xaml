<Window
    x:Class="AudioOrb.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootLayout"
          Background="Transparent"
          Loaded="RootLayout_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Opaque fallback when the selected in-app theme intentionally
             differs from the system theme and Mica cannot follow it. -->
        <Border x:Name="ThemeScrim"
                Grid.RowSpan="2"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                Opacity="0"
                IsHitTestVisible="False" />

        <Grid x:Name="TitleBarDragRegion"
              Background="Transparent"
              Padding="18,0,150,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Source="ms-appx:///Assets/Square48Logo.png"
                   Width="20"
                   Height="20"
                   VerticalAlignment="Center" />

            <TextBlock Grid.Column="1"
                       Margin="10,0,0,0"
                       Text="声枢"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="2"
                       Margin="10,0,0,0"
                       Text="AudioOrb"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
        </Grid>

        <NavigationView x:Name="Nav"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        OpenPaneLength="212"
                        CompactPaneLength="48"
                        SelectionChanged="Nav_SelectionChanged"
                        Background="Transparent">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
            </NavigationView.Resources>

            <NavigationView.PaneHeader>
                <TextBlock Text="设置"
                           Margin="18,10,0,14"
                           FontSize="20"
                           FontWeight="SemiBold" />
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="设备" Tag="devices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="外观" Tag="appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="常规" Tag="general">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" Background="Transparent" />
        </NavigationView>
    </Grid>
</Window>
